{
  "name": "jnj_bench",
  "data": {
    "source": "yahoo",
    "ticker": "JNJ",
    "start": "1990-01-01",
    "end": "2025-12-31",
    "interval": "1d"
  },
  "vol": {
    "type": "realized",
    "window": 21
  },
  "option": {
    "type": "call",
    "moneyness": 1.0,
    "maturity_steps": 21
  },
  "market": {
    "rate": 0.03,
    "cost_bps": 10,
    "steps_per_year": 252,
    "position_limits": [
      0,
      1
    ]
  },
  "split": {
    "test_start": "2019-01-01"
  },
  "episodes": {
    "stride": 5
  },
  "eval": {
    "risk_aversion": 0.3,
    "baseline": "delta_daily"
  },
  "strategies": [
    {
      "name": "no_hedge"
    },
    {
      "name": "delta_hedge",
      "label": "delta_daily"
    },
    {
      "name": "ww_band",
      "label": "ww",
      "params": {
        "risk_aversion": 0.3
      }
    },
    {
      "name": "dp",
      "label": "dp",
      "params": {
        "risk_aversion": 0.3,
        "h_range": [
          0,
          1
        ],
        "vol_grid": [
          0.05,
          0.075,
          0.1,
          0.125,
          0.15,
          0.175,
          0.2,
          0.25,
          0.3,
          0.35,
          0.4,
          0.5,
          0.6,
          0.7,
          0.8,
          0.9
        ]
      }
    },
    {
      "name": "mpc",
      "label": "mpc_band",
      "params": {
        "horizon": 21,
        "plan": "band",
        "shared_band": true,
        "n_scenarios": 1024,
        "objective": "cara",
        "risk_aversion": 0.3
      }
    },
    {
      "name": "deep_hedge",
      "label": "deep_band",
      "params": {
        "model": "models/jnj_bench/deep_band.pt",
        "arch": "band",
        "objective": {
          "type": "entropic",
          "risk_aversion": 0.3
        }
      }
    },
    {
      "name": "deep_hedge",
      "label": "deep_mlp",
      "params": {
        "model": "models/jnj_bench/deep_mlp.pt",
        "arch": "mlp",
        "objective": {
          "type": "entropic",
          "risk_aversion": 0.3
        }
      }
    },
    {
      "name": "deep_hedge",
      "label": "deep_band_garch",
      "params": {
        "model": "models/jnj_bench/deep_band_garch.pt",
        "arch": "band",
        "objective": {
          "type": "entropic",
          "risk_aversion": 0.3
        },
        "simulator": {
          "type": "gjr_garch",
          "n_paths": 100000
        }
      }
    }
  ]
}
